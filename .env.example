# SQLite file used by Prisma. For Postgres, point this at your database and
# change the provider in prisma/schema.prisma before migrating.
DATABASE_URL="file:./dev.db"

# live: call the documented Pump.fun coins-v2 endpoint.
# mock: development only. Ignored when NODE_ENV=production.
# Sample cards are labeled and are not Pump.fun Callouts.
PUMPFUN_DATA_MODE=live

# Optional override for the documented coins-v2 prefix.
# Default: https://frontend-api-v3.pump.fun/coins-v2
# PUMP_COINS_V2_BASE=https://frontend-api-v3.pump.fun/coins-v2

# coins-v2 does not use an API key. Do not add a bearer token.
# Wallet secret keys and seed phrases do not belong in this file.
